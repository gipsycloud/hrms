<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h2 class="mb-4">
        <%= locals.title %>
      </h2>
      <form action="/apartment/edit/<%= apartment.id %>" method="POST">
        <!-- Email Input -->
        <div class="mb-3">
          <label for="street" class="form-label">Street</label>
          <input type="text" class="form-control" id="street" name="street" value="<%= apartment.street %>"
            placeholder="">
        </div>

        <div class="mb-3">
          <label for="apartment_no" class="form-label">Apartment No</label>
          <input type="text" class="form-control" id="apartment_no" name="apartment_no"
            value="<%= apartment.apartment_no %>">
        </div>

        <div class="mb-3">
          <label for="floor" class="form-label">Floor</label>
          <input type="text" class="form-control" id="floor" name="floor" value="<%= apartment.floor %>">
        </div>

        <div class="mb-3">
          <label for="floor" class="form-label">Direction</label>
          <input type="text" class="form-control" id="direction" name="direction" value="<%= apartment.direction %>">
        </div>

        <div class="mb-3">
          <label class="visually" for="specificSizeSelect">Place Information</label>
          <select class="form-select" id="specificSizeSelect" name="placeId" required>
            <option value="<%= apartment.place.id %>" selected disabled>
              <span class="text-secondary">
                <%= apartment.place.address %> - Phone no: <%= apartment.place.phone %>
              </span>
            </option>
            <% places.forEach(place=> { %>
              <option value="<%= place.id %>" <%=apartment.placeId===place.id ? 'selected' : '' %>>
                <%= place.address %> - Phone no: <%= place.phone %>
              </option>
              <% }) %>
          </select>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary">Submit</button>
      </form>
    </div>
  </div>
</div>