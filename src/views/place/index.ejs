<div class="d-flex flex-column flex-md-row align-left p-3 px-md-4 mb-3 bg-white">
  <a href="/newplace">
    <button class="btn btn-outline-primary mb-2">Add New Place</button>
  </a>
</div>
<div class="table-responsive">
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th scope="col">#id</th>
        <th scope="col">Email</th>
        <th scope="col">Phone</th>
        <th scope="col">Address</th>
        <th scope="col">Description</th>
        <th scope="col">Action</th>
      </tr>
    </thead>
    <tbody>
      <% places.forEach( (place, index)=> { %>
        <tr>
          <td>
            <%= place.id %>
          </td>
          <td>
            <%= place.email %>
          </td>
          <td>
            <%= place.phone %>
          </td>
          <td>
            <%= place.address %>
          </td>
          <td>
            <%= place.description %>
          </td>
          <td>
            <a href="/place/edit/<%= place.id %>"><button class="btn btn-primary">Edit</button></a>
            <form action="/place/delete/<%= place.id %>" method="POST" style="display:inline;">
              <button type="submit" class="btn btn-danger">Delete</button>
          </td>
        </tr>
        <% }); %>
    </tbody>
  </table>
</div>