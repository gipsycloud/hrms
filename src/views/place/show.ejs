<div class="card-body">
  <h4>
    <%= locals.title %>
  </h4>
  <table class="table table-striped table-bordered">
    <tbody>
      <tr>
        <td>Email</td>
        <td>
          <%= place.email %>
        </td>
      </tr>
      <tr>
        <td>Phone</td>
        <td>
          <%= place.phone %>
        </td>
      </tr>
      <tr>
        <td>Address</td>
        <td>
          <%= place.address %>
        </td>
      </tr>
      <tr>
        <td>Description</td>
        <td>
          <%= place.description %>
        </td>
      </tr>
      <tr>
        <td>Apartment Info</td>
        <td>
          <% place.apartments.forEach(apartment=> { %>
            <%= apartment.street %>
              <% }); %>
        </td>
      </tr>
    </tbody>
  </table>
</div>